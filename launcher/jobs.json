{
  "packages": [
    "cmdstanr",
    "tidyverse",
    "loo"
  ],
  "cmdstan": true,
  "inputs": true,
  "jobs": {
    "models": {
      "cpus": 4,
      "memory": "24G",
      "time_limit": "48:00:00",
      "requires": [
        "analysis.RData"
      ],
      "commands": [
        [
          "Rscript",
          "run_takeup.R",
          "takeup",
          "fit",
          "--cmdstanr",
          "--chains=4",
          "--threads=1",
          "--output-path={output}/fits"
        ]
      ]
    }
  },
  "project": "takeup"
}
